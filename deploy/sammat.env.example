# Copy to sammat.env next to the compose file, then: chmod 600 sammat.env
# One KEY=value per line, no quotes, no spaces around "=".

# PIN for /admin (places and menus). Each round gets its own random PIN.
ADMIN_PIN=0042

# Public address, used in links in mails
PUBLIC_URL=https://sammat.example.com

# SMTP – optional. Without it the app works, but sends no mail.
# Any SMTP server or relay. Port 465 = TLS, other ports use STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must be a verified sender/domain at your mail provider
MAIL_FROM=SamMat <sammat@example.com>

# Optional
# Teams Workflows / Power Automate when "Anyone" is not allowed in your tenant:
# an Entra app (client credentials) that SamMat uses to sign its webhook calls. Ask IT – see the docs.
# FLOW_TENANT_ID=00000000-0000-0000-0000-000000000000
# FLOW_CLIENT_ID=00000000-0000-0000-0000-000000000000
# FLOW_CLIENT_SECRET=
# PHOTOS=0               # turn off photos on the notes
# CREATE_PIN=1234         # require a PIN to start a round (empty = anyone can)
# BACKUP_DAYS=7           # daily backup in <data>/backups, kept this many days (0 = off)
# ORDER_LIMIT=20          # max new orders per IP per 10 minutes
# PURGE_DAYS=7            # rounds are deleted this many days after their date
# FAVORITE_DAYS=180       # "same as last time" is forgotten this long after the last order
# MAX_ACTIVE_ROUNDS=30
